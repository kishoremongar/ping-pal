    "next": "14.2.24",
    "react": "^18",
    "react-dom": "^18",
    "stream-browserify": "^3.0.0"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "npx run lint",
      "npx test"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@swc/jest": "^0.2.37",
    "@testing-library/jest-dom": "^6.6.3",
