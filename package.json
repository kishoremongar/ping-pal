    "commitlint": "commitlint --edit",
    "type-check": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tanstack/react-query": "^5.67.3",
    "axios": "^1.8.2",
